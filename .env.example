# Copia este archivo como .env. La clave solo se lee en el servidor.
GEMINI_API_KEY=
# Modelo consultado en el catálogo de Google. Puede cambiarse según tu acceso.
GEMINI_MODEL=gemini-3.5-flash-lite

# PostgreSQL: npm run db:provision puede preparar estos valores localmente.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=nutribot_app
PGPASSWORD=
PGDATABASE=nutribot_project
PGTESTDATABASE=nutribot_project_test
